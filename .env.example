# Local development only. Replace passwords and tokens outside a local machine.
MONGO_DATABASE=travel_bot
MONGO_USER=travel
MONGO_PASSWORD=travel_dev_password
MONGO_PORT=27017

RABBITMQ_USER=travel
RABBITMQ_PASSWORD=travel_dev_password
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

AGENT_SERVICE_TOKEN=local-agent-token-change-me-1234567890
JWT_SECRET=local-jwt-secret-change-me-1234567890
BACKEND_PORT=8000
# Public Next.js port for both frontend and /api/v1/*.
FRONTEND_PORT=3000
DATA_LAYER_PORT=8080
PARSER_SERVICE_TOKEN=local-parser-token-change-me-1234567890
DATA_MODE=synthetic
AGENT_MODE=demo
# For AGENT_MODE=openai, set OPENAI_API_KEY and switch DATA_MODE as needed.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
OPENAI_REASONING_EFFORT=low
YANDEX_RASP_API_KEY=
LITEAPI_KEY=
CORS_ORIGINS=http://localhost:3000
COOKIE_SECURE=false
SSE_HEARTBEAT_SECONDS=15
SSE_POLL_SECONDS=0.5

GUEST_NATIONALITY=RU
# Optional Windows corporate TLS trust: see README. Never disable certificate verification.
# COMPOSE_FILE=docker-compose.yaml;docker-compose.ca.yaml
# COMPOSE_PATH_SEPARATOR=;
