# HTTP-сервис данных
PARSER_SERVICE_TOKEN=dev-token-change-me-in-production
PARSER_PORT=8080

# Внешние API по умолчанию. Ошибки не подменяются фикстурами.
# synthetic допустим только для явно выбранного локального демо/тестов.
DATA_MODE=live

# Обязательные ключи обоих поставщиков
# https://developer.tech.yandex.ru/
YANDEX_RASP_API_KEY=
# https://liteapi.travel/
LITEAPI_KEY=
GUEST_NATIONALITY=RU

HTTP_TIMEOUT_SECONDS=10.0
HTTP_MAX_RETRIES=3
HTTP_RETRY_BACKOFF_SECONDS=1.0
