# ── Сервис ──────────────────────────────────────────────
PARSER_SERVICE_TOKEN=dev-token-change-me-in-production
PARSER_PORT=8080

# ── Режим данных ────────────────────────────────────────
# Возможные значения:
#   synthetic      — только синтетические фикстуры (по умолчанию)
#   sandbox        — sandbox-источники + синтетика как fallback
#   live_transport — реальный транспорт, остальное синтетика
#   live           — все реальные источники + синтетика как fallback
DATA_MODE=synthetic

# ── Будущие источники данных ────────────────────────────
# Заполнить при подключении реальных адаптеров.
# Пока все значения пустые — сервис работает на синтетике.

# Яндекс Расписания (транспорт):
# Получить ключ: https://developer.tech.yandex.ru/
YANDEX_RASP_API_KEY=

# LiteAPI Sandbox (отели):
# Получить ключ: https://liteapi.travel/
LITEAPI_KEY=

# Островок API v3 (отели, приоритет №1):
# Запросить доступ у организаторов хакатона
OSTROVOK_API_KEY=

# ── HTTP-настройки для внешних адаптеров ────────────────
HTTP_TIMEOUT_SECONDS=10.0
HTTP_MAX_RETRIES=3
HTTP_RETRY_BACKOFF_SECONDS=1.0