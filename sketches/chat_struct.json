  "chat": {
    "name": "Путешествия на ноябрь",
    "history": [
      {
        "id": 1234,
        "from": "user",  // 3 варианта: agent/user/user-action
        "message": "тут сообщение в чате, для user-action не указывается",
      },
      {
        "id": 1235,
        "from": "user-action",
        "operations": [ // operations есть и для ответа агента, и для сообщения пользователя. Формат: JSON Patch (RFC 6902)
          {
            "op": "replace",
            "path": "/basic/dates/from",
            "value": "29.10.2026"
          },
          {
            "op": "remove",
            "path": "/basic/locations_tree/Европа"
          }
        ]
      },
      {
        "id": 1236,
        "from": "agent", // в ответе агента может быть либо одно из двух, либо оба поля: message и operations. Message точно должно отображаться, operations - на усмотрение фронтендера
        "message": "Обоснование решения",
        "operations": [ // вот это пока не точно
          {
            "op": "replace",
            "path": "/basic/cost-range",
            "value": "35000–42000 ₽"
          },
          {
            "op": "add",
            "path": "/variants/-",
            "value": {
              "id": 1234,
              "name": "Выходные в Уфе",
              "completed": false
            }
          }
        ]
      },
    ]
  },
  "basic": { // базовая информация о поездке, общая для всех вариантов
    "departure": "Россия, Москва, МИРЭА", // исходная локация в свободном формате, агент разберётся
    "dates": {
      "from": "-",
      "to": "-" // по умолчанию прочерки, поддерживается свободный формат типа "в августе, может в начале сентября", но должно быть коротким, чтобы красиво отображалось. При ручном выборе впишется что-то типа "24-10-2026"
    },
    "peoples": {
      "adults": 1, // по умолчанию 0
      "children": 0, // по умолчанию 0
      "unknown": 1, // по умолчанию 1,
      "additional-info": ["с собакой"], // дополнительная информация в свободном формате. Список, чтобы можно было редактировать удобно пользователю (овальчики с удалением и добавлением)
    },
    "price_restrictions": {
      "min": -1,
      "max": -1, // по умолчанию ограничений нет, либо берётся из аккаунта. Вводится ползунком, либо агент достаёт из запроса.
    },
    "cost_range": "-", // по умолчанию прочерк, если агент ещё в процессе. Потом условно заменяется постепенно на 30-50к рублей, потом на 35-40к рублей, в итоге 36500 рублей. То есть формат свободный,
    "locations_tree": { // Рассматриваемые моделью локации, на основе которых уже потом можно строить варианты.
      // Точность локации будет увеличиваться во время размышления модели, то есть сначала была только Россия и Европа, потом например появилось углубление в Кавказ и Урал.
      // На каждом уровне пользователь сможет удалить ветвь, добавить новый вариант. Это повлияет на формирование окончательных вариантов.
      // Уровни могут быть неоднородными, и это нормально
      "Россия": {
        "Урал": {
          "Екатеринбург": {},
          "Башкирия": {
            "Уфа": {},
            "Салават": {},
          }
        },
        "Кавказ": {},
        "Москва": {},
      },
      "Европа": {}
    }
  },
  "variants": [ // Несколько вариантов поездки (недоступно для редактирования кнопкам)
    {
      "id": 12345,
      "name": "Чудесная поездка в Уфу",
      "location": "Россия, Урал, Уфа", // свободный формат, но желательно, чтобы выглядел примерно так
      "price": "10к-20к", // свободный формат. Желтаельно иметь максимально точнее значение, но иногда если невозможно, писать диапазон
      "dates": {
        "from": "1 ноября", // поля обязательные, но со свободным форматом
        "to": "2 ноября", 
      }
      "completed": true/false, // Когда true, это значит, что модель заполнила все поля, получила цены, данные об отеле, ссылки (либо пропустила поля, если нет данных). false - модель ещё обдумывает вариант
      "description": "...",
      "urls": [...], // список источников
      "habitations": [ // список всех посещённых гостиниц, отелей и т.д. за один вариант путешествия
          {
            "id": 38752501,
            "name": "Общежитие ПТУ №3",
            "description": "...",
            "dates": {
              "from": "-",
              "to": "-"
            },
            "url": "...",
            "price": "42 рубля",
            "additional": [ 
              // Другие поля от агента в любом формате
              // примеры полей, все они по желению агента, если он смог найти информацию, или нужно что-то уточнить. Названия полей на том же языке, что идёт запрос, чтобы на фронтеде отобразить их
              { "label": "Тип комнаты", "value": "Семейная" },
              { "label": "Заезд", "value": "12:00" }
            ]
          }
          ,
          {
            // ... следующий отель
          }
      ],
      "transports": [
        {
          "id": 222222,
          "name": "Перелёт из Москвы в Астану",
          "times": { // опциональное поле. Например, для метро не нужно, для самолёта - нужно
            "from": "-",
            "to": "-",
            "duration": "-", // для метро можно указать только duration например, для самолёта наоборот - только from и to
          },
          "type": "flight", 
          "price": "123 рубля",
          "additional": [
            { "label": "Ограничения", "value": "Багаж до 5кг" }
          ]
        }
      ],
      "additional": [
         // дополнительное. например, сюда агент можно прописать суммарное время в пути, если оно значительное
         { "label": "Время в пути", "value": "10 часрв" }
      ]
  ],
   "additional": [ 
    {
      "id": "group_city_restrictions",
